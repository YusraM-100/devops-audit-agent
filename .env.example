# Copy this file to .env and fill in ONE provider. Never commit the real .env file.

# --- Option 1: Google Gemini (has a free tier) -------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-3.8-flash

# --- Option 2: OpenAI -------------------------------------------------------
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# --- Option 3: Anthropic Claude -----------------------------------------------
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# LLM_MODEL=claude-sonnet-5-5

# --- Option 4: Groq (has a free tier) -------------------------------------------
# GROQ_API_KEY=your-groq-api-key-here

# --- Option 5: any other OpenAI-compatible server (OpenRouter, Ollama, vLLM...) -
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Optional settings
# LLM_PROVIDER=gemini          # force a provider if several keys are set
# LLM_REQUEST_DELAY=4          # seconds between LLM calls (helps with free-tier rate limits)
# AUDIT_DISABLE_PYTEST=1       # never run the target's tests, even if Docker is available
